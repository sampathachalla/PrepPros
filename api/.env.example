PORT=8000
DATABASE_URL=postgresql://preppros:preppros_dev_password@localhost:5432/preppros
# Used by `npm test`; tests wipe this database, so never point it at real data
TEST_DATABASE_URL=postgresql://preppros:preppros_dev_password@localhost:5432/preppros_test
# Stand-in for the Supabase database during `npm test` (wiped by the tests)
TEST_SUPABASE_DB_URL=postgresql://preppros:preppros_dev_password@localhost:5432/preppros_supabase_test
# Hermes Agent's API server (docker compose publishes it on localhost)
AGENT_URL=http://localhost:8642
# Must match HERMES_API_KEY in the root .env
HERMES_API_KEY=
# Must match AGENT_TOOLS_KEY in the root .env
AGENT_TOOLS_KEY=
# Supabase project (Authentication: sign-up, login, sessions)
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Supabase database (Session pooler connection string) for copies of shared links and Instagram content
SUPABASE_DB_URL=
# Path to Supabase's CA certificate, used to verify the database connection (Database settings > SSL)
SUPABASE_DB_CA_CERT=
# Server-only Supabase secret key (Project Settings > API Keys). Turns on the JSONL backup in Supabase
# Storage; it bypasses row level security, so never give it to the mobile app
SUPABASE_SECRET_KEY=
# Private Storage bucket for the backup; created on startup if missing
SUPABASE_BACKUP_BUCKET=preppros-backups
# TEMPORARY: bookmark requests with no access token act as this user id. A real token always wins.
# Remove it before real users can reach the API
TEMP_USER_ID=
# Bright Data API key for Instagram link previews (Scrapers > Instagram)
BRIGHT_DATA_API_KEY=
# YouTube Data API v3 key (video details and caption track list)
YOUTUBE_API_KEY=
