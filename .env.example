POSTGRES_DB=preppros
POSTGRES_USER=preppros
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
API_PORT=8000
AGENT_PORT=8642

# Hermes Agent (chat). GPT-6 Luna is its model, so it needs an OpenAI API key
OPENAI_API_KEY=
# Bearer key the API uses to call Hermes Agent's API server; at least 16 characters (openssl rand -hex 32)
HERMES_API_KEY=
# Shared secret for the PrepPros tools inside the Hermes container; at least 32 characters (openssl rand -hex 32)
AGENT_TOOLS_KEY=

SUPABASE_PROJECT_ID=your_project_id
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
EXPO_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# PrepPros API for the app; on a phone use your computer's LAN address, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000


# Server-only Supabase secret key (Project Settings > API Keys). Turns on the JSONL backup in Supabase
# Storage; it bypasses row level security, so never give it to the mobile app
SUPABASE_SECRET_KEY=
# Private Storage bucket for the backup; created on startup if missing
SUPABASE_BACKUP_BUCKET=preppros-backups
# TEMPORARY: bookmark requests with no access token act as this user id. A real token always wins.
# Remove it before real users can reach the API
TEMP_USER_ID=
# Bright Data API key for Instagram link previews (Scrapers > Instagram)
BRIGHT_DATA_API_KEY=
# YouTube Data API v3 key (video details and caption track list)
YOUTUBE_API_KEY=

# Supabase database (Session pooler connection string) for copies of shared links and Instagram content
SUPABASE_DB_URL=
# Supabase CA certificate inside the API container (download it to api/supabase/supabase-ca.crt)
SUPABASE_DB_CA_CERT=/app/supabase/supabase-ca.crt
