# Select which PrepPros backend the mobile bundle calls: local, tunnel, or oci.
# Production-safe default when omitted: oci.
EXPO_PUBLIC_BACKEND_TARGET=local

# Backend on this machine or LAN. A physical phone needs the Mac's LAN address.
EXPO_PUBLIC_LOCAL_API_URL=http://127.0.0.1:8000

# Filled automatically by `npm run tunnel` when exposing a local backend.
EXPO_PUBLIC_TUNNEL_API_URL=https://your-current-api-tunnel.example

# Persistent OCI API relay. The OCI tunnel service injects its actual URL at startup.
EXPO_PUBLIC_OCI_API_URL=https://your-preppros-oci-api.example

# Legacy fallback retained for existing environments.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
