[Unit]
Description=PrepPros development API
Wants=network-online.target docker.service
After=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/PrepPros/api
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=development
Environment=OCI_DATABASE_HOST=127.0.0.1
Environment=OCI_DATABASE_PORT=5433
ExecStart=/usr/bin/node /home/ubuntu/PrepPros/api/scripts/start-oci-api.mjs
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
